  "item": [
    {
      "name": "Workshop Services",
      "item": [
        {
          "name": "Order Service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}:8080/q/health/ready",
              "host": ["{{baseUrl}}"],
              "port": "8080",
              "path": ["q", "health", "ready"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order Service is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Health status is UP', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        },
