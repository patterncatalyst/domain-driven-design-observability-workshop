{
  "info": {
    "name": "05 - Load Test Validation",
    "description": "Light validation that the system handles sequential traffic without 500 errors. Not a real load test -- use hey/ghz for that.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sequential Checkouts",
      "item": [
        {
          "name": "Load checkout 1 - silver standard",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartId\": \"cart_load_001\",\n  \"customerId\": \"cust_alice_silver\",\n  \"lineItems\": [\n    { \"sku\": \"SKU-100\", \"quantity\": 2, \"unitPrice\": 29.99 }\n  ],\n  \"paymentMethod\": \"credit_card\",\n  \"shippingClass\": \"standard\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}:8080/api/orders/checkout",
              "host": ["{{baseUrl}}"],
              "port": "8080",
              "path": ["api", "orders", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No 500 error on checkout 1', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 422]);",
                  "});",
                  "",
                  "pm.test('Response is valid JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ]
        },
